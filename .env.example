# PostgreSQL Connection (Required for persistence)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contract_lens"

# Server Port (Default: 5000)
PORT=5000

# Node Environment
NODE_ENV=development

# Optional: OpenAI API Key for AI Incident Diagnosis
# If omitted, ContractLens automatically runs its intelligent heuristic SRE Rule Engine
OPENAI_API_KEY=""
