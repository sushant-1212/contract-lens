# PostgreSQL Connection (Optional: if omitted or unreachable, ContractLens uses in-memory resilience store)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contract_lens"

# Server Port (Default: 5000)
PORT=5000

# Node Environment
NODE_ENV=development

# Optional AI Incident Diagnosis (xAI Grok, Groq, or OpenAI)
# If omitted or API is unreachable, ContractLens automatically runs its deterministic SRE Rule Engine
GROK_API_KEY=""         # xAI Grok (e.g. xai-...) - model: grok-2-latest
# XAI_API_KEY=""        # Alternative alias for Grok
# GROQ_API_KEY=""       # Groq (e.g. gsk_...) - model: llama-3.3-70b-versatile
# OPENAI_API_KEY=""     # OpenAI (e.g. sk-...) - model: gpt-4o-mini
